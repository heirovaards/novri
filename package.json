{
  "name": "lkps",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:conventions": "tsx scripts/run-convention-checks.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm check:conventions && pnpm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate && tsx src/backend/db/sql/apply-audit-triggers.ts",
    "db:seed": "tsx src/backend/db/seed/run-seed.ts",
    "db:reset": "tsx scripts/db-reset.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.6",
    "@tanstack/react-table": "9.3.1",
    "archiver": "8.0.0",
    "better-auth": "1.7.23",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "cn": "0.5.2",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.4",
    "exceljs": "4.4.0",
    "file-type": "22.3.0",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/archiver": "8.0.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-unicorn": "79.0.0",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
